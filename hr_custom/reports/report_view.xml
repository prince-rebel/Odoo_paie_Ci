<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_work_certificate" model="ir.actions.report">
            <field name="name">Attestation de travail</field>
            <field name="model">hr.employee</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hr_custom.report_work_certificate</field>
            <field name="report_file">hr_custom.report_work_certificate</field>
            <field name="print_report_name">'Attestation de travail - %s' % (object.identification_id)</field>
            <field name="binding_model_id" ref="model_hr_employee"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_employee_resignation" model="ir.actions.report">
