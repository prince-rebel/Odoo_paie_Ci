<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_work_accident_pdf">
            <t t-call="web.html_container">
                <t t-call="hr_custom.doc_report_employee_layout">
                    <div class="page" style="text-align: center; padding:175px 0px 50px 0px;">
                        <br/>
                        <center>
                            <table style="border-collapse:collapse;bordercolor=#111111; align:center;">
                                <tr>
                                    <td style="border:none; width:20%;"/>
                                    <td style="border:3px solid black; width:60%; align:center; text-align:center;font-family:Trebuchet MS ;
                                                padding-top: 20px">
                                        <h3 style="font-family:DejaVu Serif;">
                                            <b>LISTE DES ACCIDENTS DE TRAVAIL</b>
                                        </h3>
                                    </td>
                                    <td style="border:none; width:20%;"/>
                                </tr>
                            </table>
                        </center>
                        <br/>
                        <br/>
                        <t t-set="num" t-value="1"/>
                        <table class="table" style="text-align:center;padding-top:2px;">
                            <tr>
                                <td style="font-family:DejaVu Serif;">
                                    N°
                                </td>
                                <td style="font-family:DejaVu Serif;">
                                    Référence
                                </td>
                                <td style="font-family:DejaVu Serif;">
                                    MTLE
                                </td>
                                <td style="font-family:DejaVu Serif;">
                                    NOM ET PRENOMS
                                </td>
                                <td style="font-family:DejaVu Serif;">
                                    FONCTION
                                </td>
                                <td style="font-family:DejaVu Serif;">
                                    SERVICE
                                </td>
                                <td style="font-family:DejaVu Serif;">
                                    DEPARTEMENT
                                </td>
                                <td style="font-family:DejaVu Serif;">
                                    DIRECTION
                                </td>
                                <td style="font-family:DejaVu Serif;">
                                    SEXE
                                </td>
                                <td style="font-family:DejaVu Serif;">
                                    NAISSANCE
                                </td>
                                <td style="font-family:DejaVu Serif;">
                                    AGE
                                </td>
                                <td style="font-family:DejaVu Serif;">
                                    DATE DE L'ACCIDENT
                                </td>
                            </tr>
                            <t t-foreach="work_accident" t-as="o">
                                <tr>
                                    <td>
                                        <span t-out="num"/>
                                        <t t-set="num" t-value="num+1"/>
                                    </td>
                                    <td>
                                        <t t-out="o['reference']" style="font-family:DejaVu Serif;"/>
                                    </td>
                                    <td>
                                        <t t-out="o['identification_id']" style="font-family:DejaVu Serif;"/>
                                    </td>
                                    <td>
                                        <t t-out="o['name']" style="font-family:DejaVu Serif;"/>
                                    </td>
                                    <td>
                                        <t t-out="o['job_id']" style="font-family:DejaVu Serif;"/>
                                    </td>
                                    <td>
                                        <span t-out="o['service_id']" style="font-family:DejaVu Serif;"/>
                                    </td>
                                    <td>
                                        <span t-out="o['department_id']" style="font-family:DejaVu Serif;"/>
                                    </td>
                                    <td>
                                        <span t-out="o['direction_id']" style="font-family:DejaVu Serif;"/>
                                    </td>
                                    <td>
                                        <span t-out="o['gender']" style="font-family:DejaVu Serif;"/>
                                    </td>
                                    <td>
                                        <span t-out="o['birthday']" style="font-family:DejaVu Serif;"/>
                                    </td>
                                    <td>
                                        <span t-out="o['age']" style="font-family:DejaVu Serif;"/>
                                    </td>
                                    <td>
                                        <span t-out="o['accident_date']" style="font-family:DejaVu Serif;"/>
                                    </td>
                                </tr>
                            </t>
                        </table>
                        <div style="margin-left:700px; padding-top: 25px;text-align:right;">
                            <div>
                                <h6 style="font-family:DejaVu Serif;">Fait à Abidjan, le
                                    <span t-out="date" style="font-family:DejaVu Serif;text-transform: capitalize;"/>.
                                </h6>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>