<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Gestion des accidents de travail -->
        <record id="work_accident_tree_view" model="ir.ui.view">
            <field name="name">hr_custom.work_accident.tree</field>
            <field name="model">hr_custom.work_accident</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="accident_date"/>
                    <field name="name"/>
                    <field name="employee_id"/>
                </tree>
            </field>
        </record>

        <record id="work_accident_form_view" model="ir.ui.view">
            <field name="name">hr_custom.work_accident.form</field>
            <field name="model">hr_custom.work_accident</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                        <group col="4">
                            <field name="accident_date"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="work_accident_description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="work_accident_search_view" model="ir.ui.view">
            <field name="name">hr_custom.work_accident.search</field>
            <field name="model">hr_custom.work_accident</field>
            <field name="arch" type="xml">
                <search string="Search. Accident de travail">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <group expand="1" string="Group By">
                        <filter string="Date de l'accident" name="accident_date" domain="[]"
                                context="{'group_by':'accident_date'}"/>
                        <filter string="Employé" name="employee_id" domain="[]" context="{'group_by':'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="work_accident_act_window" model="ir.actions.act_window">
            <field name="name">Accidents de travail</field>
            <field name="res_model">hr_custom.work_accident</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" eval="False"/>
            <field name="search_view_id" ref="work_accident_search_view"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Vous pouvez créer le premier accident de travail en cliquant sur le bouton créer situé en haut
                    à gauche.
                </p>
            </field>
        </record>

    </data>
</odoo>