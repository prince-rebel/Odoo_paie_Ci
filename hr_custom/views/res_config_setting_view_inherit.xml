<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
            <field name="name">hr_custom.res.config.settings.form</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="70"/>
            <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <block name="employee_rights_setting_container" position="after">
                    <h2>Alertes</h2>
                    <div class="row mt16 o_settings_container" name="alert_contract">
                        <div class="col-12 col-lg-6 o_setting_box" id="alert_contract_expiry_cadre">
                            <div class="o_setting_right_pane">
                                <label for="alert_contract_expiry_cadre"/>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."
                                      role="img" aria-label="Values set here are company-specific."
                                      groups="base.group_multi_company"/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        Alerte fin de contrat des cadres estimée en jour
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="alert_contract_expiry_cadre"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- -->
                        <div class="col-12 col-lg-6 o_setting_box" id="alert_contract_expiry_non_cadre">
                            <div class="o_setting_right_pane">
                                <label for="alert_contract_expiry_non_cadre"/>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."
                                      role="img" aria-label="Values set here are company-specific."
                                      groups="base.group_multi_company"/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        Alerte fin de contrat des non cadres estimée en jour
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="alert_contract_expiry_non_cadre"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- -->
                        <div class="col-12 col-lg-6 o_setting_box" id="alert_trial_contract_expiry">
                            <div class="o_setting_right_pane">
                                <label for="alert_trial_contract_expiry"/>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."
                                      role="img" aria-label="Values set here are company-specific."
                                      groups="base.group_multi_company"/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        Alerte fin de période d'essai
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="alert_trial_contract_expiry"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_settings_container" name="second_alert_contract">
                        <!-- -->
                        <div class="col-12 col-lg-6 o_setting_box" id="first_retirement_alert">
                            <div class="o_setting_right_pane">
                                <label for="first_retirement_alert"/>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."
                                      role="img" aria-label="Values set here are company-specific."
                                      groups="base.group_multi_company"/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        Première alerte de départ à la retraite estimée en mois
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="first_retirement_alert"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- -->
                        <div class="col-12 col-lg-6 o_setting_box" id="second_retirement_alert">
                            <div class="o_setting_right_pane">
                                <label for="second_retirement_alert"/>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."
                                      role="img" aria-label="Values set here are company-specific."
                                      groups="base.group_multi_company"/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        Deuxième alerte de départ à la retraite estimée en mois
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="second_retirement_alert"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </block>
            </field>
        </record>
    </data>
</odoo>