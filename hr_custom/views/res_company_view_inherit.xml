<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_company_form_inherit" model="ir.ui.view">
            <field name="name">hr_custom.res_company.form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Informations administratives">
                        <group col="4" string="Responsables">
                            <field name="hr_general_manager_id"/>
                            <field name="hr_director_id"/>
                            <field name="hr_manager_id"/>
                            <field name="payroll_manager_id"/>
                            <field name="hr_assistant_id"/>
                            <field name="payroll_assistant_id"/>
                        </group>
                        <group col="4" string="Autres informations">
                            <field name="retirement_age"/>
                        </group>

                    </page>
                </notebook>

            </field>
        </record>
    </data>
</odoo>