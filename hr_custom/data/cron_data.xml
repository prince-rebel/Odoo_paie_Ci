<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_end_contract" model="ir.cron">
            <field name="name">Alerte fin de contrat</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="hr.model_hr_version"/>
            <field name="state">code</field>
            <field name="code">model.cron_end_contract_notification()</field>
        </record>

        <record id="cron_determine_date_retirement" model="ir.cron">
            <field name="name">Determine date de retraite</field>
            <field name="active" eval="True" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="hr_custom.model_hr_employee" />
            <field name="state">code</field>
            <field name="code">model.cron_determine_date_retirement_all_employee()</field>
            <field name="priority" eval="5" />
        </record>

        <record id="cron_send_mail_retirement" model="ir.cron">
            <field name="name">Alerte depart à la retraite</field>
            <field name="active" eval="True" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="hr_custom.model_hr_employee" />
            <field name="state">code</field>
            <field name="code">model.cron_send_mail_retirement()</field>
            <field name="priority" eval="5" />
        </record>

    </data>
</odoo>
