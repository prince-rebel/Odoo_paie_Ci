<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_calcul_inverse" model="ir.ui.view">
        <field name="name">hr.contract.form.calcul.inverse</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header" position="inside">
                <button name="action_calculer_sursalaire" 
                        string="🎯 Calculer Sursalaire" 
                        type="object" 
                        class="oe_highlight"
                        invisible="net_souhaite == 0" 
                        force_save="1"/>
                <button name="action_simuler_paie" 
                        string="📊 Simuler Paie" 
                        type="object"
                        class="btn-info"
                        invisible="not (wage > 0 and employee_id)"/>
                <button name="action_reinitialiser_calcul" 
                        string="🔄 Réinitialiser" 
                        type="object"
                        invisible="net_souhaite == 0" 
                        force_save="1"/>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="🎯 Calcul Inversé" name="calcul_inverse_ci">
                    
                    <div class="alert alert-info" role="alert">
                        <h4><i class="fa fa-info-circle"/> Mode d'emploi</h4>
                        <ol>
                            <li>Saisissez le <strong>net souhaité</strong> par l'employé</li>
                            <li>Vérifiez le <strong>salaire de base (wage)</strong></li>
                            <li>Configurez les <strong>primes fixes</strong> dans l'onglet correspondant (transport, assurance, CMU)</li>
                            <li>Cliquez sur <strong>"Calculer Sursalaire"</strong></li>
                            <li>Le système génère automatiquement le <strong>sursalaire (extra_pay)</strong></li>
                        </ol>
                        <p class="text-muted">
                            <small>
                                Le calcul prend en compte : Salaire de base, Sursalaire, Prime d'ancienneté, ITS, CNPS (6.3%), 
                                Prime de transport (non imposable), Assurance maladie, CMU
                            </small>
                        </p>
                    </div>
                    
                    <group string="🎯 Paramètres du Calcul Inversé">
                        <group>
                            <field name="net_souhaite" 
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   class="oe_inline"/>
                            <field name="wage" 
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="0"/>
                            <field name="employee_id" 
                                   required="1"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="extra_pay" 
                                   string="Sursalaire Calculé"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"
                                   class="oe_bold"/>
                            <label for="employee_id" string="Ancienneté"/>
                            <div>
                                <field name="employee_id" 
                                       invisible="1"/>
                                <span invisible="not employee_id">
                                    <field name="employee_id" 
                                           string="" 
                                           widget="selection"
                                           class="oe_inline"
                                           readonly="1"
                                           options="{'no_create': True}"/>
                                    <span class="text-muted"> - </span>
                                    <span class="text-muted">
                                        Ancienneté calculée automatiquement
                                    </span>
                                </span>
                            </div>
                        </group>
                    </group>
                    
                    <separator string="📊 Résultat du Calcul"/>
                    <group>
                        <group string="Éléments Calculés">
                            <field name="brut_imposable_calcule" 
                                   string="Brut Imposable"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                            <field name="its_calcule" 
                                   string="ITS"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                        </group>
                        <group string="Résultat Final">
                            <field name="net_a_payer_calcule" 
                                   string="Net à Payer"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"
                                   class="oe_bold"
                                   style="font-size: 16px; color: #00A09D;"/>
                            <div invisible="net_souhaite == 0">
                                <span>Écart : </span>
                                <field name="net_a_payer_calcule" invisible="1"/>
                                <field name="net_souhaite" invisible="1"/>
                                <span class="badge badge-info">
                                    <field name="net_a_payer_calcule" 
                                           widget="monetary"
                                           readonly="1"
                                           options="{'currency_field': 'currency_id'}"/> - 
                                    <field name="net_souhaite" 
                                           widget="monetary"
                                           readonly="1"
                                           options="{'currency_field': 'currency_id'}"/>
                                </span>
                            </div>
                        </group>
                    </group>
                    
                    <separator string="ℹ️ Informations Importantes"/>
                    <group>
                        <group>
                            <p class="text-muted">
                                <strong>Formule du Brut Imposable :</strong><br/>
                                BRUT = BASE (wage) + SURSA (extra_pay) + PANC (prime ancienneté)
                            </p>
                            <p class="text-muted">
                                <strong>Prime d'Ancienneté :</strong><br/>
                                - 0% si ancienneté &lt; 2 ans<br/>
                                - 2% + (ancienneté - 2) si ≥ 2 ans<br/>
                                - Maximum 25%
                            </p>
                        </group>
                        <group>
                            <p class="text-muted">
                                <strong>Retenues Salariales :</strong><br/>
                                - ITS : selon barème progressif 2025<br/>
                                - CNPS : 6,3% (max 3.375.000 FCFA)<br/>
                                - CMU : selon configuration<br/>
                                - Assurance : selon configuration
                            </p>
                            <p class="text-muted">
                                <strong>Primes Non Imposables :</strong><br/>
                                À configurer dans l'onglet "Primes Fixes"
                            </p>
                        </group>
                    </group>
                    
                </page>
            </xpath>
            
        </field>
    </record>
    
    <record id="hr_contract_view_tree_calcul_inverse" model="ir.ui.view">
        <field name="name">hr.contract.tree.calcul.inverse</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wage']" position="after">
                <field name="extra_pay" 
                       string="Sursalaire"
                       optional="show"
                       sum="Total Sursalaire"/>
                <field name="net_souhaite" 
                       string="Net Souhaité"
                       optional="hide"/>
                <field name="net_a_payer_calcule" 
                       string="Net Calculé"
                       optional="show"
                       widget="monetary"/>
            </xpath>
        </field>
    </record>
    
</odoo>