<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="inverse_calculation_form" model="ir.ui.view">
            <field name="name">inverse.calculation.form</field>
            <field name="model">hr_payroll_custom.inverse_calculation</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Calcul Inverse">
                    <sheet>
                        <group>
                            <group>
                                <field name="type_calcul"  select="1"/>
                            </group>
                            <group>
                                <field name="montant"/>
                            </group>
                            <group>
                                <group>
                                    <button name="compute" type="object" string="Calculer"/>
                                </group>
                            </group>
                        </group>
                    </sheet>

                </form>
            </field>
        </record>

        <record id="inverse_calculation_act_window" model="ir.actions.act_window">
            <field name="name">Calcul inverse</field>
            <field name="res_model">hr_payroll_custom.inverse_calculation</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>