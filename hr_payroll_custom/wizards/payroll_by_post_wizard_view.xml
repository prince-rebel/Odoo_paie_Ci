<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="payroll_by_post_form_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.payroll_by_post.form</field>
            <field name="model">hr_payroll_custom.payroll_by_post</field>
            <field name="arch" type="xml">
                <form string="Rubrique de paye par poste et période">
                    <group col="4">
                        <field name="date_from" required="1"/>
                        <field name="date_to" required="1"/>
                        <field name="rule_id" string="Rubrique" required="1"/>
                        <field name="company_id" required="1"/>
                    </group>
                    <footer>
                        <button string="Imprimer en PDF" name="print_report_pdf" type="object" class="btn-primary"/>
                        <button string="Imprimer en XLS" name="print_report_xls" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="payroll_by_post_act_window" model="ir.actions.act_window">
            <field name="name">Etat des rubriques de paie par poste et période</field>
            <field name="res_model">hr_payroll_custom.payroll_by_post</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>



    </data>
</odoo>