<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="payroll_variables_view_form" model="ir.ui.view">
            <field name="name">hr_payroll_custom.payroll_variables.form</field>
            <field name="model">hr_payroll_custom.payroll_variables</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group col="4">
                            <field name="type"/>
                            <field name="rule_id"/>
                            <field name="data_file"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="compute_data" string="Importer" type="object"/>
                        or
                        <button name="cancel" string="Annuler" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="payroll_variables_act_window" model="ir.actions.act_window">
            <field name="name">Import les variables des salaires</field>
            <field name="res_model">hr_payroll_custom.payroll_variables</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>