<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Rubriques système prédéfinies (TRSP, ASM, CMU).
        Elles réutilisent les input types existants (créés dans hr_payslip_input_type_data.xml).
        Aucune règle salariale n'est auto-créée (is_system=True).
        noupdate="1" : créées une seule fois, jamais écrasées par un upgrade.
    -->
    <data noupdate="1">

        <record id="prime_type_trsp" model="hr_payroll_custom.prime_type">
            <field name="name">Transport</field>
            <field name="code">TRSP</field>
            <field name="is_taxable" eval="False"/>
            <field name="is_system" eval="True"/>
            <field name="description">Indemnité de transport (non imposable, règle TRSP)</field>
        </record>

        <record id="prime_type_asm" model="hr_payroll_custom.prime_type">
            <field name="name">Assurance maladie</field>
            <field name="code">ASM</field>
            <field name="is_taxable" eval="False"/>
            <field name="is_system" eval="True"/>
            <field name="description">Assurance maladie salarié (retenue, règle Maladie)</field>
        </record>

        <record id="prime_type_cmu" model="hr_payroll_custom.prime_type">
            <field name="name">Mutuelle CMU</field>
            <field name="code">CMU</field>
            <field name="is_taxable" eval="False"/>
            <field name="is_system" eval="True"/>
            <field name="description">Couverture Maladie Universelle (500 FCFA/part)</field>
        </record>

    </data>
</odoo>
