        <!-- [102] PANC - Primes d'anciennété -->
        <record id="salary_rule_panc" model="hr.salary.rule">
            <field name="name"><![CDATA[Primes d'anciennété]]></field>
            <field name="code">PANC</field>
            <field name="sequence">102</field>
            <field name="struct_id" ref="structure_cdi_cdd"/>
            <field name="category_id" ref="cat_prim"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
hiring_date = employee.hiring_date
if not hiring_date:
    result = 0
else:
    payslip_date = payslip.date_from
    years = payslip_date.year - hiring_date.year
    if (payslip_date.month, payslip_date.day) < (hiring_date.month, hiring_date.day):
        years -= 1
    anciennete = years
    salaire_categoriel = version.wage
    if anciennete < 2:
        taux = 0
    else:
        taux = 2 + int(anciennete - 2)
        if taux > 25:
            taux = 25
    result = salaire_categoriel * (taux / 100)
            ]]></field>
        </record>

