        <!-- [400] ITS - Impôt sur traitement de salaires -->
        <record id="salary_rule_its" model="hr.salary.rule">
            <field name="name">Impôt sur traitement de salaires</field>
            <field name="code">ITS</field>
            <field name="sequence">400</field>
            <field name="struct_id" ref="structure_cdi_cdd"/>
            <field name="category_id" ref="impot_employ"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
if BRUT < 75000:
    result1 = 0
elif BRUT <= 240000:
    result1 = (BRUT - 75000) * 0.16
elif BRUT <= 800000:
    result1 = (BRUT - 240000) * 0.21 + 26400
elif BRUT <= 2400000:
    result1 = (BRUT - 800000) * 0.24 + 144000
elif BRUT <= 8000000:
    result1 = (BRUT - 2400000) * 0.28 + 528000
else:
    result1 = (BRUT - 8000000) * 0.32 + 2096000
parts = employee.part_igr

if parts == 1:
    reduction = 0
elif parts == 1.5:
    reduction = 5500
elif parts == 2:
    reduction = 11000
elif parts == 2.5:
    reduction = 16500
elif parts == 3:
    reduction = 22000
elif parts == 3.5:
    reduction = 27500
elif parts == 4:
    reduction = 33000
elif parts == 4.5:
    reduction = 38500
else:
    reduction = 44000   # maximum (5 parts)

result = max(0, result1 - reduction)
            ]]></field>
        </record>

