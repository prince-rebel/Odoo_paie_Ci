        <!-- [1] BASIC - Basic Salary -->
        <record id="salary_rule_basic" model="hr.salary.rule">
            <field name="name">Basic Salary</field>
            <field name="code">BASIC</field>
            <field name="sequence">1</field>
            <field name="struct_id" ref="structure_cdi_cdd"/>
            <field name="category_id" ref="hr_payroll.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
# Available variables:
#----------------------
# payslip: hr.payslip object
# employee: hr.employee object
# contract: hr.contract object
# rules: dict containing the rules code (previously computed)
# categories: dict containing the computed salary rule categories (sum of amount of all rules belonging to that category).
# worked_days: dict containing the computed worked days
# inputs: dict containing the computed inputs.

# Note: returned value have to be set in the variable 'result'

result = payslip.paid_amount
            ]]></field>
        </record>

        <!-- [2] WORK100 - Jours travaillés -->
        <record id="salary_rule_work100" model="hr.salary.rule">
            <field name="name">Jours travaillés</field>
            <field name="code">WORK100</field>
            <field name="sequence">2</field>
            <field name="struct_id" ref="structure_cdi_cdd"/>
            <field name="category_id" ref="cat_jpay"/>
            <field name="condition_select">python</field>
            <field name="condition_python"><![CDATA[result = worked_days['WORK100'].number_of_days if 'WORK100' in worked_days else False]]></field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
result = min((payslip.date_to - payslip.date_from).days + 1, 30)
            ]]></field>
        </record>

        <!-- [98] TX - Taux -->
        <record id="salary_rule_tx" model="hr.salary.rule">
            <field name="name">Taux</field>
            <field name="code">TX</field>
            <field name="sequence">98</field>
            <field name="struct_id" ref="structure_cdi_cdd"/>
            <field name="category_id" ref="taux"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"><![CDATA[
nb_jours = worked_days['WORK100'].number_of_days if 'WORK100' in worked_days else WORK100
result = min(1.00 * nb_jours / 30, 1.0)
            ]]></field>
