<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="balance_any_account_form_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.balance_any_account.form</field>
            <field name="model">hr_payroll_custom.balance_any_account</field>
            <field name="arch" type="xml">
                <form string="Balance any account form">
                    <header>
                        <button name="generate_data" string="Calculer" type="object" invisible="state != 'draft'"/>
                        <button name="action_done" string="Valider" type="object" invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>

                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                        </group>
                        <group>
                        <group>
                            <field name="employee_id" readonly="state == 'validate'"/>
                            <field name="deposit_date" required="True" readonly="state == 'validate'"/>
                            <field name="hiring_date" readonly="1"/>
                            <field name="end_date" required="True" readonly="state == 'validate'"/>
                            <field name="other_indemnity" readonly="state == 'validate'"/>
                            <field name="date_return_last_holidays" readonly="1"/>
                            <field name="holiday_bonuses" readonly="0"/>
                        </group>
                    </group>

                            <group>
                                <field name="version_id" readonly="1"/>
                                <field name="estimated_departure_date" readonly="1"/>
                                <field name="seniority" readonly="1"/>
                                <field name="motif_fin_contract_id" required="True" readonly="state == 'validate'"/>
                                <field name="medal_leave" readonly="state == 'validate'"/>
                                <field name="gross_salary_leave" readonly="1"/>
                                <field name="job_search_time" readonly="0"/>
                            </group>

                        <group>
                            <group>
                                <field name="total_gross" readonly="True"/>
                                <field name="notice_given"/>
                            </group>
                            <group>
                                <field name="average_gross" readonly="True"/>
                                <field name="notice_not_given"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="total_indemnity"/>
                            </group>
                            <group>
                                <field name="spreading_period" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="taxable_indemnity"/>
                            </group>
                            <group>
                                <field name="not_taxable_indemnity"/>
                            </group>
                        </group>

                        <group string="NET A PAYER">
                            <field name="net_payable" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Derniers bulletins">
                                <field name="last_salary_line_ids" readonly="1">
                                    <list>
                                        <field name="order"/>
                                        <field name="period"/>
                                        <field name="gross_amount" sum="Total brut"/>
                                        <field name="payslip_id"/>
                                    </list>
                                    <form>
                                        <group>
                                            <field name="order"/>
                                            <field name="name"/>
                                            <field name="period"/>
                                            <field name="gross_amount"/>
                                            <field name="payslip_id"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Indemnités" invisible="not allowances_ids">
                                <field name="allowances_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="amount" sum="Total indemnité"/>
                                    </list>
                                    <form>
                                        <group col="4">
                                            <field name="name"/>
                                            <field name="amount"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Elements du salaire">
                                <field name="salary_elements_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="amount" sum="Total"/>
                                    </list>
                                    <form>
                                        <group col="4">
                                            <field name="name"/>
                                            <field name="amount"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Recapitulatif">
                                <separator string="Rubriques imposables"/>
                                <field name="taxable_section_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="amount" sum="Total"/>
                                    </list>
                                    <form>
                                        <group col="4">
                                            <field name="name"/>
                                            <field name="amount"/>
                                            <field name="rule_id"/>
                                        </group>
                                    </form>
                                </field>
                                <separator string="Impôts et cotisations"/>
                                <field name="tax_balance_any_account_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="amount" sum="Total"/>
                                    </list>
                                    <form>
                                        <group col="4">
                                            <field name="name"/>
                                            <field name="amount"/>
                                            <field name="rule_id"/>
                                        </group>
                                    </form>
                                </field>
                                <separator string="Rubriques non imposables"/>
                                <field name="not_taxable_section_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="amount" sum="Total"/>
                                    </list>
                                    <form>
                                        <group col="4">
                                            <field name="name"/>
                                            <field name="amount"/>
                                            <field name="rule_id"/>
                                        </group>
                                    </form>
                                </field>
                                <group class="oe_subtotal_footer oe_right" style="margin-right: 50px">
                                    <label for="net_payable"/>
                                    <field name="net_payable" nolabel="1" widget="monetary" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="balance_any_account_tree_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.balance_any_account.tree</field>
            <field name="model">hr_payroll_custom.balance_any_account</field>
            <field name="arch" type="xml">
                <list string="Balance any account tree">
                    <field name="name"/>
                    <field name="motif_fin_contract_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="balance_any_account_search_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.balance_any_account.search</field>
            <field name="model">hr_payroll_custom.balance_any_account</field>
            <field name="arch" type="xml">
                <search string="Balance any account search">
                    <field name="name"/>
                    <group>
                        <filter string="Employé" name="employee_id" domain="[]"
                                context="{'group_by':'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="balance_any_account_act_window" model="ir.actions.act_window">
            <field name="name">Solde de tout compte</field>
            <field name="res_model">hr_payroll_custom.balance_any_account</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="balance_any_account_search_view"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new ModelTitle.
                </p>
            </field>
        </record>

        <record id="hr_departure_reason_form_inherit" model="ir.ui.view">
            <field name="name">hr.departure.reason form</field>
            <field name="model">hr.departure.reason</field>
            <field name="inherit_id" ref="hr.hr_departure_reason_view_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="indemnity"/>
                </field>
            </field>
        </record>

    </data>
</odoo>