<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_employee_form_inherit" model="ir.ui.view">
            <field name="name">hr_payroll_custom.hr_employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr_custom.hr_employee_form_inherit"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <field name="employee_status" position="after">
                    <field name="annual_leave_payment_date"/>
                    <field name="days_worked_since_last_leave"/>
                    <field name="leave_balance"/>
                </field>
                <field name='part_cmu' position="after">
                    <field name="cmu_contributor"/>
                </field>
                <notebook position="inside">
                    <page string="Primes" name="primes_page">
                        <div class="alert alert-info mb-3" role="alert">
                            <i class="fa fa-info-circle me-1"/>
                            <strong>Comment ajouter une prime :</strong>
                            <ul class="mb-0">
                                <li>Prime déjà connue (Transport, Rendement, Gratification,
                                    Congé, Indemnité de représentation...) : sélectionnez-la
                                    dans la liste et indiquez le montant.</li>
                                <li>Nouvelle prime qui n'existe pas encore : tapez son nom
                                    puis cliquez sur "Créer et modifier..." pour préciser si
                                    elle est <strong>imposable</strong> ou
                                    <strong>non imposable</strong>. Elle sera ensuite prise
                                    en compte automatiquement dans le bulletin de paie, sans
                                    intervention technique.</li>
                            </ul>
                        </div>
                        <field name="fixed_premiums_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="input_type_id"
                                       options="{'no_quick_create': True}"
                                       context="{'form_view_ref': 'hr_payroll_custom.view_hr_payslip_input_type_form_premium'}"/>
                                <field name="amount"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </field>
        </record>

    </data>
</odoo>