<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="cnps_monthly_form_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.cnps_monthly.form</field>
            <field name="model">hr_payroll_custom.cnps_monthly</field>
            <field name="arch" type="xml">
                <form string="Formulaire CNPS">
                    <header>
                        <button name="compute" string="Calculer" type="object"/>
                        <!--<button name="export_xls" string="Export la liste des contributeurs" type="object"/>-->
                    </header>
                    <sheet>
                        <group col="2">
                            <field name="name"/>
                        </group>
                        <group col="4">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"/>
                            <!-- <field name="type_employee" widget="radio"/>-->
                        </group>
                        <notebook>
                            <page string="Lignes">
                                <field name="line_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="number_of_employees"/>
                                        <field name="retirement_plan"/>
                                        <field name="other_plan"/>
                                    </tree>
                                    <form>
                                        <group col="4">
                                            <field name="name" readonly="1"/>
                                            <field name="number_of_employees" readonly="1"/>
                                            <field name="retirement_plan" readonly="1"/>
                                            <field name="other_plan" readonly="1"/>
                                        </group>
                                    </form>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="total_gross_salary"/>
                                    <field name="total_employee"/>
                                    <field name="total_cnps_base"/>
                                    <field name="total_other_base"/>
                                </group>
                            </page>
                            <page string="Le recap. employé">
                                <field name="cnps_monthly_line_ids">
                                    <tree>
                                        <field name="employee_id"/>
                                        <field name="type"/>
                                        <field name="gross_salary"/>
                                        <field name="cnps_tax_base"/>
                                        <field name="other_tax_base"/>
                                        <field name="daily_base"/>
                                        <field name="cnps_amount"/>
                                        <field name="maternity_insurance_amount"/>
                                        <field name="family_benefit_amount"/>
                                        <field name="work_accident_amount"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="cnps_slice_id"/>
                                    </tree>
                                    <form>
                                        <group col="4">
                                            <field name="employee_id" readonly="1"/>
                                            <field name="type" readonly="1"/>
                                            <field name="gross_salary" readonly="1"/>
                                            <field name="cnps_tax_base" readonly="1"/>
                                            <field name="other_tax_base" readonly="1"/>
                                            <field name="daily_base" readonly="1"/>
                                            <field name="cnps_amount" readonly="1"/>
                                            <field name="maternity_insurance_amount" readonly="1"/>
                                            <field name="family_benefit_amount" readonly="1"/>
                                            <field name="work_accident_amount" readonly="1"/>
                                            <field name="date_start" readonly="1"/>
                                            <field name="date_end" readonly="1"/>
                                            <field name="cnps_slice_id" readonly="1"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Cotisations">
                                <field name="cotisation_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="amount_submitted"/>
                                        <field name="rate"/>
                                        <field name="amount_contributed"/>
                                    </tree>
                                    <form>
                                        <group col="4">
                                            <field name="name" readonly="1"/>
                                            <field name="amount_submitted" readonly="1"/>
                                            <field name="rate" readonly="1"/>
                                            <field name="amount_contributed" readonly="1"/>
                                        </group>
                                    </form>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="total_amount_of_contributions"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="cnps_monthly_tree_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.cnps_monthly.tree.view</field>
            <field name="model">hr_payroll_custom.cnps_monthly</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="company_id"/>
                    <field name="total_employee"/>
                    <field name="total_cnps_base"/>
                    <field name="total_other_base"/>
                </tree>
            </field>
        </record>

        <record id="cnps_monthly_act_window" model="ir.actions.act_window">
            <field name="name">CNPS Mensuel</field>
            <field name="res_model">hr_payroll_custom.cnps_monthly</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" eval="False"/>
        </record>

    </data>
</odoo>