<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============ État résumé des cotisations ============ -->
        <record id="contribution_summary_form_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.contribution_summary.form</field>
            <field name="model">hr_payroll_custom.contribution_summary</field>
            <field name="arch" type="xml">
                <form string="État résumé des cotisations">
                    <header>
                        <button string="Calculer" name="action_compute" type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Ex. : Résumé cotisations septembre 2026"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="closure_mode" widget="radio"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="employee_ids" widget="many2many_tags"/>
                                <field name="payslip_count"/>
                                <field name="compute_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Rubriques" name="lines">
                                <field name="line_ids" readonly="1">
                                    <list>
                                        <field name="group_id"/>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="rate_employee"/>
                                        <field name="rate_employer"/>
                                        <field name="rate_total"/>
                                        <field name="assiette" sum="Total"/>
                                        <field name="base"/>
                                        <field name="amount_employee" sum="Total"/>
                                        <field name="amount_employer" sum="Total"/>
                                        <field name="amount_total" sum="Total"/>
                                        <field name="headcount_male"/>
                                        <field name="headcount_female"/>
                                    </list>
                                </field>
                                <group class="oe_subtotal_footer">
                                    <field name="total_employee"/>
                                    <field name="total_employer"/>
                                    <field name="total_global" class="oe_subtotal_footer_separator"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="contribution_summary_list_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.contribution_summary.list</field>
            <field name="model">hr_payroll_custom.contribution_summary</field>
            <field name="arch" type="xml">
                <list string="États résumés des cotisations">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="closure_mode"/>
                    <field name="total_employee" sum="Total"/>
                    <field name="total_employer" sum="Total"/>
                    <field name="total_global" sum="Total"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="contribution_summary_act_window" model="ir.actions.act_window">
            <field name="name">État résumé des cotisations</field>
            <field name="res_model">hr_payroll_custom.contribution_summary</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Créer un état résumé des cotisations</p>
                <p>Synthèse mensuelle des impôts, cotisations CNPS et taxes FDFP par rubrique.</p>
            </field>
        </record>

        <!-- ============ Paramétrage : groupes et rubriques ============ -->
        <record id="contribution_summary_rubric_list_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.contribution_summary_rubric.list</field>
            <field name="model">hr_payroll_custom.contribution_summary_rubric</field>
            <field name="arch" type="xml">
                <list string="Rubriques état résumé" editable="bottom">
                    <field name="group_id"/>
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="employee_rule_code"/>
                    <field name="employer_rule_code"/>
                    <field name="assiette_code"/>
                    <field name="rate_employee"/>
                    <field name="rate_employer"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="contribution_summary_rubric_search_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.contribution_summary_rubric.search</field>
            <field name="model">hr_payroll_custom.contribution_summary_rubric</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <filter name="inactive" string="Archivées" domain="[('active', '=', False)]"/>
                    <group>
                        <filter name="group_by_group" string="Groupe" context="{'group_by': 'group_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="contribution_summary_rubric_act_window" model="ir.actions.act_window">
            <field name="name">Rubriques état résumé des cotisations</field>
            <field name="res_model">hr_payroll_custom.contribution_summary_rubric</field>
            <field name="view_mode">list</field>
            <field name="context">{'search_default_group_by_group': 1}</field>
        </record>

        <record id="contribution_summary_group_list_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.contribution_summary_group.list</field>
            <field name="model">hr_payroll_custom.contribution_summary_group</field>
            <field name="arch" type="xml">
                <list string="Groupes état résumé" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="contribution_summary_group_act_window" model="ir.actions.act_window">
            <field name="name">Groupes état résumé des cotisations</field>
            <field name="res_model">hr_payroll_custom.contribution_summary_group</field>
            <field name="view_mode">list</field>
        </record>

    </data>
</odoo>
