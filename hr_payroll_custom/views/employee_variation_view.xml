<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="employee_variation_form_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.employee_variation.form</field>
            <field name="model">hr_payroll_custom.employee_variation</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Récapitulatif des salaires">
                    <header>
                        <button string="Calculer" name="action_compute" type="object" class="btn-primary"
                                context="{'xls_export':1}" icon="fa-calculator"/>
                    </header>
                    <sheet>
                        <field name="name"/>
                        <group>
                            <group string="Période antérieure">
                                <field name="old_date_from" readonly="1"/>
                                <field name="old_date_to" readonly="1"/>
                                <field name="total_previous_employees" readonly="1"/>
                            </group>
                            <group string="Période en cours">
                                <field name="date_from" required="1"/>
                                <field name="date_to" required="1"/>
                                <field name="total_current_employees" readonly="1"/>
                                <field name="employees_in" readonly="1"/>
                                <field name="employees_out" readonly="1"/>
                            </group>
                            <group>
                                <field name="company_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Liste des employés">
                                <field name="employee_ids">
                                    <tree editable="bottom">
                                        <field name="employee_id" readonly="1" string="Nom et Prénoms"/>
                                        <field name="identification_id"/>
                                        <field name="type" readonly="1"/>
                                        <field name="observation"/>
                                    </tree>
                                    <form>
                                        <group col="4">
                                            <field name="employee_id" readonly="1"/>
                                            <field name="identification_id" readonly="1"/>
                                            <field name="type" readonly="1"/>
                                            <field name="observation"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>

                </form>
            </field>
        </record>

        <record id="employee_variation_tree_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.employee_variation.tree</field>
            <field name="model">hr_payroll_custom.employee_variation</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Récapitulatif des salaires">
                    <field name="name"/>
                     <field name="old_date_from"/>
                    <field name="old_date_to"/>
                    <field name="total_previous_employees"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="total_current_employees"/>
                    <field name="employees_in"/>
                    <field name="employees_out"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="employee_variation_act_window" model="ir.actions.act_window">
            <field name="name">Etat de variation des effectifs</field>
            <field name="res_model">hr_payroll_custom.employee_variation</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" eval="False"/>
        </record>

    </data>
</odoo>