<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fdfp_settings_form_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.fdfp_settings.form</field>
            <field name="model">hr_payroll_custom.fdfp_settings</field>
            <field name="arch" type="xml">
                <form string="">
                    <group col="4">
                        <field name="rule_id"/>
                        <field name="rate"/>
                        <field name="sequence"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="fdfp_settings_tree_view" model="ir.ui.view">
            <field name="name">hr_payroll_custom.fdfp_settings.tree.view</field>
            <field name="model">hr_payroll_custom.fdfp_settings</field>
            <field name="arch" type="xml">
                <list string="">
                    <field name="rule_id"/>
                    <field name="rate"/>
                    <field name="sequence"/>
                </list>
            </field>
        </record>

        <record id="fdfp_settings_act_window" model="ir.actions.act_window">
            <field name="name">Paramètres FDFP</field>
            <field name="res_model">hr_payroll_custom.fdfp_settings</field>
            <field name="view_mode">list,form</field>
        </record>



    </data>
</odoo>