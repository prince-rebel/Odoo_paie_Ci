<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_company_form_inherit" model="ir.ui.view">
            <field name="name">hr_payroll_custom.res_company.form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="before">
                    <field name="system_implementation_date"/>
                </field>
                <field name="partner_id" position="after">
                    <field name="address"/>
                </field>
                <field name="retirement_age" position="after">
                    <field name="bonus_transport"/>
                </field>
                <notebook position="inside">
                    <page string="Configuration des Impôts">
                        <group col="4" string="CNPS">
                            <field name="employer_identification_cnps" required="True"/>
                            <field name="max_cnps_tax_base"/>
                            <field name="max_other_tax_base"/>
                            <field name="establishment_code"/>
                            <field name="activity_code"/>
                            <field name="activity_label"/>
                        </group>
                        <group col="4" string="ITS">
                            <field name="acronym"/>
                            <field name="legal_status"/>
                            <field name="tax_base_service"/>
                            <field name="account_number"/>
                        </group>
                        <group string="Etat 301">
                            <field name="profession"/>
                        </group>
                        <group string="CMU">
                            <field name="cmu_amount"/>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
