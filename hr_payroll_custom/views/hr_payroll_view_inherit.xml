<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_payslip_form_inherit" model="ir.ui.view">
            <field name="name">hr_payroll_custom.hr_payslip.form</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <button name="compute_sheet" position="before">
                    <button name="calculate_leave_allowances" string="Calcul All. Congé" type="object"
                            confirm="Voulez-vous vraiment calculer l'allocation congé de cet employé?"
                            invisible="state != 'draft'"/>
                </button>
                <xpath expr="//field[@name='number_of_days']" position="attributes">
                    <attribute name="readonly">0</attribute>
                </xpath>
                <xpath expr="//field[@name='number_of_hours']" position="attributes">
                    <attribute name="readonly">0</attribute>
                </xpath>
                <field name='struct_id' position="after">
                    <label for="slip_seniority_year" string="Ancienneté"/>
                    <div>
                        <field name="slip_seniority_year" class="oe_inline"/> Ans - <field name="slip_seniority_month" class="oe_inline"/> Mois
                    </div>
                </field>
                <xpath expr="//page[@name='salary_computation']" position="inside">
                    <group string="Récapitulatif de la paye">
                        <group>
                            <field name="base_daily"/>
                            <field name="gross_taxable"/>
                        </group>
                        <group>
                            <field name="total_gross"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//page/field[@name='input_line_ids']/form/group/field[@name='amount']" position="before">
                    <field name="code" invisible="1"/>
                    <field name="number_days_off" invisible="code not in ('CNGP','CONG')"/>
                </xpath>
                <xpath expr="//page/field[@name='worked_days_line_ids']/list/field[@name='amount']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>


        <record id="hr_payslip_run_form_inherit" model="ir.ui.view">
            <field name="name">hr_payroll_custom.hr_payslip_run.form</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="before">
                    <header>
                        <button name="%(payroll_variables_act_window)s" string="Importer les variables des salaires"
                                invisible="state != '01_ready'" type="action"/>
                    </header>
                </xpath>

            </field>
        </record>

    </data>
</odoo>