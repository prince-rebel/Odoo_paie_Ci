<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_its_monthly">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="hr_payroll_custom.its_monthly_layout">
                        <div class="page" style="padding-top:5px;padding-bottom:1px;">
                            <p style="font-size:14px;padding-top:2px;text-align:justify">
                                Nom et Prénoms ou Raison sociale .......................
                                <span t-out="o.company_id.name"/>
                                <br/>
                                Sigle..............<span t-out="o.company_id.acronym"/>...............Forme:...<span
                                    t-out="o.company_id.legal_status"/>...........................
                                <br/>
                                <span>Adresse: .....
                                    <span t-out="o.company_id.street2" style="margin-left:10px"/>
                                    <span t-out="o.company_id.city" style="margin-left:10px"/>
                                    <span t-out="o.company_id.country_id.name" style="margin-left:10px"/>
                                    .................
                                </span>
                                ....................................
                                <span style="margin-left:50px">Tel:.......
                                    <span t-out="o.company_id.phone"/>
                                    .............
                                </span>
                                <br/>
                                service d'assiette des impôts divers de ......<span
                                    t-out="o.company_id.tax_base_service"/>.......................................
                            </p>
                            <table style="width:100%;border:1px solid black;border-collapse:collapse">
                                <tr style="height:15px;">
                                    <td style="border:none">PERIODE D'IMPOSITION:
                                        <span t-out="o.date_from.strftime('%m')" style="margin-left:10px"/>
                                        <t t-if="3 >= int(o.date_from.strftime('%m')) and int(o.date_from.strftime('%m'))>=1">
                                            <t t-set="quarter" t-value="1"/>
                                            <span style="margin-left:20px">0
                                                <t t-out="quarter"/>
                                            </span>
                                        </t>
                                        <t t-if="int(o.date_from.strftime('%m'))>3 and  6>=int(o.date_from.strftime('%m'))">
                                            <t t-set="quarter" t-value="2"/>
                                            <span style="margin-left:20px">0
                                                <t t-out="quarter"/>
                                            </span>
                                        </t>
                                        <t t-if="9 >= int(o.date_from.strftime('%m')) and int(o.date_from.strftime('%m'))>6">
                                            <t t-set="quarter" t-value="3"/>
                                            <span style="margin-left:20px">0
                                                <t t-out="quarter"/>
                                            </span>
                                        </t>
                                        <t t-if="12 >= int(o.date_from.strftime('%m')) and int(o.date_from.strftime('%m'))>9">
                                            <t t-set="quarter" t-value="4"/>
                                            <span style="margin-left:20px">0
                                                <t t-out="quarter"/>
                                            </span>
                                        </t>
                                        <span style="margin-left:29px">
                                            <span t-out="o.date_from.strftime('%Y')"/>
                                        </span>
                                    </td>
                                    <td style="border:none">
                                        <b>N° de COMPTE</b>
                                        <b>
                                            <span t-out="o.company_id.account_number"/>
                                        </b>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="height:10px;border:none">
                                        <span style="margin-left:150px">
                                            <span style="margin-left:3px">Mois</span>
                                            <span style="margin-left:7px">Trim</span>
                                            <span style="margin-left:14px">Année</span>
                                        </span>
                                    </td>
                                    <td style="height:10px;border:none"/>
                                </tr>
                            </table>
                            <div>
                                <table style="width:100%;border-collapse:collapse">
                                    <tr>
                                        <td colspan="8" style="border:none">
                                            <b>A - IMPOTS RETENUS AUX SALARIES</b>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" style="border:1px solid black">
                                            0 1 - <b>IS</b>(Régime général seulement)
                                            <br/>
                                            0 2 - <b>CN</b>(Régime général seulement)
                                            <br/>
                                            0 3 - <b>IGR</b>(Régime général)
                                            <br/>
                                            0 4 - <b>IGR</b>(Régime agricole)
                                            <br/>
                                            0 6 -
                                            <b>Total des retenues aux salariés(1+2+3+4)</b>
                                        </td>
                                        <td style="border:1px solid black;text-align:right;">
                                            <t t-if="o.total_its_employee > 0">
                                                <span t-out="'{0:,.0f}'.format(o.total_its_employee).replace(',', ' ')"/>
                                            </t>
                                            <br/>
                                            <t t-if="o.total_cn > 0">
                                                <span t-out="'{0:,.0f}'.format(o.total_cn).replace(',', ' ')"/>
                                            </t>
                                            <br/>
                                            <t t-if="o.total_igr_employee > 0">
                                                <span t-out="'{0:,.0f}'.format(o.total_igr_employee).replace(',', ' ')"/>
                                            </t>
                                            <br/>
                                            <br/>
                                            <t t-if="o.total_retenu_employee > 0">
                                                <span t-out="'{0:,.0f}'.format(o.total_retenu_employee).replace(',', ' ')"/>
                                            </t>

