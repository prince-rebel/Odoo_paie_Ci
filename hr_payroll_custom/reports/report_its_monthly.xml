                                                <span t-out="'{0:,.0f}'.format(o.total_mt_a_payer_expat).replace(',', ' ')"/>
                                            </t>
                                            <br/>
                                            <br/>
                                            <br/>
                                            <span t-out="'{0:,.0f}'.format(o.total_mt_a_payer).replace(',', ' ')"/>
                                        </td>
                                    </tr>
