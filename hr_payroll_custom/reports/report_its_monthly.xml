                                                <b>RESERVE A<br/>L'ADMINISTRATION
                                                </b>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" style="border:none;border-left:none">
                                            <b>B - IMPOTS A LA CHARGE DE L'EMPLOYEUR</b>
                                        </td>
                                        <td style="border:1px solid black"/>
                                        <td rowspan="9" style="border:1px solid black;border-top:none"/>
                                    </tr>
