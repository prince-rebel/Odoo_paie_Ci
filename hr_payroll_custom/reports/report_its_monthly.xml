                                        <td style="border:1px solid black"/>
                                        <td style="border:1px solid black"/>
                                        <td style="border:1px solid black;text-align:right;">
                                            <span t-out="'{0:,.0f}'.format(o.amount_total).replace(',', ' ')"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="4" style="border:none;">
                                            <table style="border-collapse:collapse;margin-left:90px;width:730px;">
                                                <tr>
                                                    <td colspan="4" style="border:1px solid black;text-align:center">
                                                        POUR MEMOIRE: DETERMINATION DU TAUX D'USAGE
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="border:1px solid black;text-align:center;width:100px">
                                                        Budget
