                                        <td style="border:1px solid black">TOTAL SALAIRES BRUTS</td>
                                        <td style="border:1px solid black">MONTANTS A PAYER</td>
                                    </tr>
                                    <tr>
                                        <td style="border:1px solid black">
                                            0 7 -
                                            <b>Personnel local(Régime général) (1,20%)</b>
                                            <br/>
                                            0 8 -
                                            <b>Personnel expatrié(Regime général) (10,40%)</b>
                                            <br/>
                                            0 9 -
                                            <b>Régime agricole (1,20%)</b>
                                            <br/>
                                            1 0 -
                                            <b>Régime fermage(35,00%)</b>
                                            <br/>
                                            1 1 -
                                            <b>Ensemble du personnel (7+8+9)</b>
                                            <br/>
                                        </td>
                                        <td style="border:1px solid black;text-align:right;">
                                            <t t-if="o.total_number_local > 0">
                                                <span t-out="'{0:,.0f}'.format(o.total_number_local).replace(',', ' ')"/>
                                            </t>
                                            <br/>
                                            <t t-if="o.total_number_expat">
                                                <span t-out="'{0:,.0f}'.format(o.total_number_expat).replace(',', ' ')"/>
                                            </t>
                                            <br/>
                                            <br/>
                                            <br/>
                                            <span t-out="'{0:,.0f}'.format(o.total_number).replace(',', ' ')"/>
                                        </td>
                                        <td style="border:1px solid black;text-align:right;">
                                            <t t-if="o.total_brut_imposable_local > 0">
                                                <span t-out="'{0:,.0f}'.format(o.total_brut_imposable_local).replace(',', ' ')"/>
                                            </t>
                                            <br/>
                                            <t t-if="o.total_brut_imposable_expat > 0">
                                                <span t-out="'{0:,.0f}'.format(o.total_brut_imposable_expat).replace(',', ' ')"/>
                                            </t>
                                            <br/>
                                            <br/>
                                            <br/>
                                            <span t-out="'{0:,.0f}'.format(o.total_brut_imposable_local + o.total_brut_imposable_expat).replace(',', ' ')"/>
                                        </td>
                                        <td style="border:1px solid black;text-align:right;">
                                            <t t-if="o.total_mt_a_payer_local > 0">
                                                <span t-out="'{0:,.0f}'.format(o.total_mt_a_payer_local).replace(',', ' ')"/>
                                            </t>
