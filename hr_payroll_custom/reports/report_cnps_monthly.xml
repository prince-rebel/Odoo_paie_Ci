<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_cnps_monthly">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div class="text-center" style="font-family:DejaVu Serif;">
                            <b>
                                <h4 style="margin-left:200px;font-weight: bold;">CAISSE NATIONALE DE PREVOYANCE SOCIALE
                                    DE COTE D'IVOIRE
                                </h4>
                            </b>
                            <table class="header" style="width:100%;text-align:center;padding-top:2px;border:none">
                                <tr>
                                    <td style="border:none;width:10%;">
                                        <span style="margin-left:10px">
                                            <img src="/hr_payroll_custom/static/src/img/logo_cnps_2.png"
                                                 style="max-height: 80px;"/>
                                        </span>
                                    </td>
                                    <td style="border:none;width:28%;">
                                        <span>
                                            <b>
                                                <p style="text-align:justify;font-size:12px;">24, Avenue
                                                    Lamblin.Plateau, 01 B.P.317
                                                    Abidjan01
                                                    <br/>
                                                    Tél: 20 32 08 66 / 20 32 76 22 Fax : 20 32 79 94
                                                    <br/>
                                                    Serveur Vocal : 20 305 305 - 20 306 306
                                                </p>
                                            </b>
                                        </span>
                                    </td>
                                    <td style="border:none;width:70%;">
                                        <b>
                                            <h6 style="text-align:center">
                                                APPEL DE COTISATION MENSUELLE
                                            </h6>
                                        </b>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="border:none;">
                                        <table style="width:300px;font-size:12px;height:50px;border-collapse:collapse;">
                                            <tr>
                                                <td style="border:1px solid black">
                                                    <b>Code Etab</b>
                                                </td>
                                                <td style="border:1px solid black">
                                                    <b>Code Activ.</b>
                                                </td>
                                                <td style="border:1px solid black">
                                                    <b>N°Employeur</b>
                                                </td>
                                                <td style="border:1px solid black">
                                                    <b>Periode</b>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="border:1px solid black">
                                                    <span t-esc="o.company_id.establishment_code"/>
                                                </td>
                                                <td style="border:1px solid black">
                                                    <span t-esc="o.company_id.activity_code"/>
                                                </td>
                                                <td style="border:1px solid black">
                                                    <span t-esc="o.company_id.employer_identification_cnps"/>
                                                </td>
                                                <td style="border:1px solid black">
                                                    <span t-esc="o.date_from.strftime('%m/%Y')"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="justify:auto;text-align:center;border:none;">
                                        <p style="text-align:justify;margin-left:250px">
                                            <b style="font-size:15px">Raison sociale</b>:
                                            <span t-esc="o.company_id.name" style="font-size:15px"/>
                                            <br/>
                                            <b style="font-size:15px">Adresse</b>:
                                            <span t-esc="o.company_id.street2" style="font-size:15px"/>
                                            <span t-esc="o.company_id.city" style="font-size:15px;margin-left:10px"/>
                                            <span t-esc="o.company_id.country_id.name"
                                                  style="font-size:15px;margin-left:10px"/>
                                        </p>
                                    </td>
                                </tr>
                            </table>
                            <table style="width:882px;font-size:12px;height:15px; margin-left:45px;border:none;">
                                <tr style="border:none;">
                                    <td style="width:670px;border:none;font-size:15px">
                                        <b>TOTAL SALAIRES BRUTS PAYES AU COURS DE LA PERIODE :</b>
                                    </td>
                                    <td style="width:200px;border:2px solid black;text-align:right">
                                        <b>
                                            <span t-esc="'{0:,.0f}'.format(int(o.total_gross_salary)).replace(',', ' ')"
                                                  style="font-size:17px"/>
                                        </b>
                                    </td>
                                    <td style="width:12px;border:none;"/>
                                </tr>
                            </table>
                            <div style="display:block;padding-top:4px;">
                                <span style="float:left">
                                    <table style="font-size:12px;width:1040px;height:auto;border:none;text-align:center;border-collapse: collapse;">
                                        <tr>
                                            <td rowspan="2" style="border:1px solid black">
                                                <b>CATEGORIE DE SALAIRES</b>
                                            </td>
                                            <td rowspan="2" style="border:1px solid black">
                                                <b>Nombre<br/>de
                                                    <br/>
                                                    salariés
                                                </b>
                                            </td>
                                            <td colspan="2" style="border:1px solid black;">
                                                <b>SALAIRES BRUTS SOUMIS A COTISATIONS</b>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="border:1px solid black">
                                                <b>REGIME DE RETRAITE</b>
                                                <h8>
                                                    <br/>
                                                    Plafond = 3.375.000 F par mois
                                                </h8>
                                                <br/>

                                            </td>
                                            <td style="border:1px solid black;width:350px;">
                                                <b>
                                                    REGIME DES PREST. FAMIL. ET DES ACCID. DU TRAVAIL
                                                </b>
                                                <br/>
                                                <h8 style="text-align:left;">Plafond = 3231 F par jour ou 75.000 par
                                                    mois
                                                </h8>

                                            </td>
                                        </tr>
                                        <tr t-foreach="o.line_ids" t-as="line">
                                            <td style="border:1px solid black;text-align:left;">

                                                <span t-field="line.name" style="text-align:left"/>

                                            </td>
                                            <td style="border:1px solid black;text-align:right">
                                                <t t-if="line.number_of_employees &gt; 0">
                                                    <span t-field="line.number_of_employees"/>
                                                </t>
                                            </td>
                                            <td style="border:1px solid black;text-align:right">
                                                <t t-if="line.retirement_plan">
                                                    <span t-field="line.retirement_plan"/>
                                                </t>
                                            </td>
                                            <td style="border:1px solid black;text-align:right">
                                                <t t-if="line.other_plan">
                                                    <span t-field="line.other_plan"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="border:1px solid black">
                                                <b>TOTAL</b>
                                            </td>
                                            <td style="border:1px solid black;text-align:right">
                                                <b>
                                                    <span t-field="o.total_employee" style="text-align:right"/>
                                                </b>
                                            </td>
                                            <td style="border:1px solid black;text-align:right">
                                                <b>
                                                    <span t-field="o.total_cnps_base" style="text-align:right"/>
                                                </b>
                                            </td>
                                            <td style="border:1px solid black;text-align:right">
                                                <b>
                                                    <span t-field="o.total_other_base" style="text-align:right"/>
                                                </b>
                                            </td>
                                        </tr>
                                    </table>
                                </span>
                                <span>
                                    <table style="width:180px;height:80px;font-size:12px;text-align:center;border:none;margin-left:10px">
                                        <tr>
                                            <td style="border:none;">
                                                <br/>
                                                <br/>
                                                <p style="font-size:12px;margin-left:0">
                                                    <b style="text-align:center;">Bordereau certifié exact,</b>
                                                    <br/>
                                                    <br/>
                                                    <b>A Abidjan, le
                                                        <span t-esc="datetime.datetime.now().strftime('%d/%m/%Y')"/>
                                                    </b>
                                                    <br/>
                                                    <br/>
                                                    <br/>
                                                    <b>Signature et cachet</b>
                                                </p>
                                            </td>
                                        </tr>
                                    </table>
                                </span>
                            </div>

                            <div style="display:block;padding-top:3px;">
                                <span style="float:left;width:880px;">
                                    <span style="float:left;padding-top:5px">
                                        <table style="font-size:12px;width:850px;height:auto;border:none;border-collapse:collapse;">
                                            <tr>
                                                <td style="border:none;width:50%;border:none"/>
                                                <td style="width:12%;text-align:center;border:1px solid black">
                                                    <b>NOMBRE</b>
                                                </td>
                                                <td style="width:17%;text-align:center;border:1px solid black">
                                                    <b>SALAIRES BRUTS</b>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="border:1px solid black">
                                                    Personnes ne cotisant pas au Régime de la Retraite
                                                </td>
                                                <td style="border:1px solid black"/>
                                                <td style="border:1px solid black"/>
                                            </tr>
                                            <tr>
                                                <td style="border:1px solid black">
                                                    Personnes pour qui l’employeur ne cotise pas
                                                    au Régime des Prestations Familiales
                                                </td>
                                                <td style="border:1px solid black"/>
                                                <td style="border:1px solid black"/>
                                            </tr>
                                        </table>
                                    </span>

                                    <span style="float:left;height:auto;">
                                        <table style="width:870px;height:auto;font-size:12px;border:none;border-collapse: collapse;">
                                            <tr style="border:none;">
                                                <td colspan="4" style="border:none;text-align:left;">
                                                    <h7>
                                                        <b>DECOMPTE DES COTISATIONS DUES</b>
                                                    </h7>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="text-align:center;width:40%;border:1px solid black">
                                                    <h7>
                                                        <b>RUBRIQUES</b>
                                                    </h7>
                                                </td>
                                                <td style="text-align:center;;border:1px solid black">
                                                    <h7>
                                                        <b>Salaires soumis à cotisations</b>
                                                    </h7>
                                                </td>
                                                <td style="text-align:center;border:1px solid black">
                                                    <h7>
                                                        <b>Taux</b>
                                                    </h7>
                                                </td>
                                                <td style="text-align:center;border:1px solid black">
                                                    <h7>
                                                        <b>Montant (Francs CFA)</b>
                                                    </h7>
                                                </td>
                                            </tr>
                                            <tr t-foreach="o.cotisation_ids" t-as="line">
                                                <td style="text-align:left;border:1px solid black">
                                                    <h7>

                                                        <span t-field="line.name"/>

                                                    </h7>
                                                </td>
                                                <td style="border-bottom:none;border-top:none;border:1px solid black;text-align:right;">
                                                    <h7>

                                                        <span t-field="line.amount_submitted"/>

                                                    </h7>
                                                </td>
                                                <td style="border-bottom:none;border-top:none;border:1px solid black;text-align:right;">
                                                    <h7>
                                                        <span t-field="line.rate"/>%

                                                    </h7>
                                                </td>
                                                <td style="border:1px solid black;text-align:right;">
                                                    <h7>

                                                        <span t-field="line.amount_contributed"/>

                                                    </h7>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="3" style="border:1px solid black;text-align:right;">
                                                    <h7>
                                                        <b>Total cotisation à payer</b>
                                                    </h7>
                                                </td>
                                                <td style="border:1px solid black;text-align:right">
                                                    <h7 style="text-align:right">
                                                        <b>
                                                            <span t-field="o.total_amount_of_contributions"/>
                                                        </b>
                                                    </h7>
                                                </td>
                                            </tr>
                                        </table>
                                    </span>
                                </span>
                                <span style="float:right;padding-top:5px;">
                                    <table style="font-size:13px;width:320px">
                                        <tr>
                                            <td style="border:1px solid black;text-align:justify;">
                                                <p style="font-size:12px;text-align:center;">
                                                    <b>ATTENTION</b>
                                                </p>
                                                <p style="font-size:12px;text-justify:inter-word;">
                                                    Il est vivement conseillé d’annexer à la présente déclaration
                                                    votre titre de payement faute de quoi vous serez responsable
                                                    du retard des pertes et des erreurs de comptabilisations.
                                                    <br/>
                                                    Le titre de paiement (de préférence un chèque bancaire ou postal)
                                                    doit
                                                    être libellé à l’ordre de la Direction Financière et Comptable de la
                                                    CNPS, même en absence de
                                                    tout paiement.
                                                    <br/>
                                                    La présente déclaration doit être dûment remplie et
                                                    obligatoirement retournée à la CNPS.
                                                </p>
                                            </td>
                                        </tr>
                                    </table>
                                </span>
                            </div>
                            <div style="display:block;padding-top:10px">
                                <br/>
                                <table style="width:100%;font-size:13px;border:none;padding-top:30px;border-collapse: collapse;">
                                    <tr>
                                        <td colspan="10" style="text-align:center;border:1px solid black">
                                            <b>CADRE RESERVE A LA C.N.P.S. (NE RIEN INSCRIRE S.V.P)</b>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:center;border:1px solid black">
                                            <b>Code op.</b>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <b>Date de journée</b>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <b>N°Pièce</b>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <b>Période</b>
                                        </td>
                                        <td style="text-align:center;border:1px solid black;width:130px;">
                                            <b>Code Virement</b>
                                        </td>
                                        <td style="text-align:center;border:1px solid black;width:110px;">
                                            <b>Banque</b>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <b>Référence du titre de paiement</b>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <b>Emission du</b>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <b>Montant</b>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <b>Visa DIRECTEUR</b>
                                        </td>
                                    </tr>
                                    <tr style="height:20px;">
                                        <td style="text-align:center;border:1px solid black">
                                            <br/>
                                            <br/>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <br/>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <br/>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <br/>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <br/>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <br/>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <br/>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <br/>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <br/>
                                        </td>
                                        <td style="text-align:center;border:1px solid black">
                                            <br/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>