<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_payroll_by_post_pdf">
            <t t-call="web.html_container">
                <t t-call="hr_payroll_custom.payroll_report_layout">
                    <div class="page" style="padding-top:50px;">
                        <style type="text/css">
                            table {
                                border-collapse: collapse;
                                font-size: 16px;
                                width: 100%;
                                }
                            tr td {
                            border: solid gray 1px;
                            }
                        </style>
                        <div style="padding-top:5px;text-align:center;">
                            <p style="padding-top:5px;">
                                <h4 style="font-family:DejaVu Serif;"> <b> ETAT DES RUBRIQUES </b></h4>
                            </p>
                        </div>
                        <br/>
                        <div>
                            <t t-foreach="details_report" t-as="i">
                                <p style="font-size:15px;font-family:DejaVu Serif;">
                                    <strong> Période <t t-out="i['date_from']" style="margin-left:170px;font-family:DejaVu Serif;"/> - <t t-out="i['date_to']" style="font-family:DejaVu Serif;"/></strong>
                                </p>
                                <p style="font-size:15px;font-family:DejaVu Serif;">
                                    <strong> Rubrique Code </strong> <t t-out="i['rubrique']" style="margin-left:60px;font-family:DejaVu Serif;"/>
                                    <span style="margin-left:150px;font-family:DejaVu Serif;"> <strong> Rubrique </strong> <span t-out="i['rule_id']" style="font-family:DejaVu Serif;"/>  </span>
                                </p>
                            </t>
                            <p>
                                <t t-set="num_line" t-value="0"/>
                                <t t-set="total_deduction" t-value="0"/>
                                <t t-set="total_earning" t-value="0"/>
                                <table>
                                    <tr>
                                        <td style="font-family:DejaVu Serif;">
                                            <strong>N°</strong>
                                        </td>
                                        <td style="font-family:DejaVu Serif;width:50px;">
                                            <strong>Matricule</strong>
                                        </td>
                                        <td style="font-family:DejaVu Serif;width:300px;">
                                            <strong>Nom et Prenoms</strong>
                                        </td>
                                        <td style="text-align: center; font-family:DejaVu Serif;">
                                            <strong>Base</strong>
                                        </td>
                                        <td style="text-align: center; font-family:DejaVu Serif;">
                                            <strong>Quantité</strong>
                                        </td>
                                        <td style="text-align: center; font-family:DejaVu Serif;">
                                            <strong>Taux (%)</strong>
                                        </td>
                                        <td style="text-align: center; font-family:DejaVu Serif;">
                                            <strong>Retenues</strong>
                                        </td>
                                        <td style="text-align: center; font-family:DejaVu Serif;">
                                            <strong>Gains</strong>
                                        </td>
                                    </tr>
                                    <t t-foreach="res" t-as="o">
                                        <t t-set="num_line" t-value="num_line + 1"/>
                                        <tr>
                                            <td style="font-family:DejaVu Serif;">
                                                <t t-out="num_line"
                                                   style="font-family:DejaVu Serif;font-size:15px;"/>
                                            </td>
                                            <td style="font-family:DejaVu Serif;">
                                                <t t-out="o['matricule']" style="font-family:DejaVu Serif;"/>
                                            </td>
                                            <td style="font-family:DejaVu Serif;">
                                                <t t-out="o['full_name']" style="font-family:DejaVu Serif;"/>
                                            </td>
                                            <td style="font-family:DejaVu Serif;text-align:right;align:right;">
                                                <t t-out="'{0:,.0f}'.format(int(o['base'])).replace(',', ' ')"
                                                   style="float:right;font-family:DejaVu Serif;"/>
                                            </td>
                                            <td style="font-family:DejaVu Serif;text-align:right;align:right;">
                                                <t t-out="o['quantity']" style="float:right;font-family:DejaVu Serif;"/>
                                            </td>
                                            <td style="font-family:DejaVu Serif;text-align:center;">
                                                <t t-out="o['taux']" style="text-align:center;align:center;font-family:DejaVu Serif;"/>
                                            </td>
                                            <td style="font-family:DejaVu Serif;text-align:right;">
                                                <t t-if="o['imputation_type']=='deductions'">
                                                    <t t-out="'{0:,.0f}'.format(int(o['amount'])).replace(',', ' ')"
                                                       style="float:right;font-family:DejaVu Serif;"/>
                                                    <t t-set="total_deduction" t-value="total_deduction+o['amount']"/>
                                                </t>
                                            </td>
                                            <td style="font-family:DejaVu Serif;text-align:right;">
                                                <t t-if="o['imputation_type']== 'earnings'">
                                                    <t t-out="'{0:,.0f}'.format(int(o['amount'])).replace(',', ' ')"
                                                       style="float:right;font-family:DejaVu Serif;"/>
                                                    <t t-set="total_earning" t-value="total_earning+o['amount']"/>
                                                </t>
                                            </td>

                                        </tr>
                                    </t>
                                    <tr style="border:none;">
                                        <td colspan="4" style="border:none; margin-left:500px;"/>
                                        <td colspan="2" style="border:none; margin-left:500px;">
                                            <strong style="text-align:right;font-size:15px;"> Total Général: </strong>
                                        </td>
                                        <td style="border:1px solid black;text-align:right;align:right">
                                            <b>
                                                <t t-out="'{0:,.0f}'.format(int(total_deduction)).replace(',', ' ')"
                                                   style="text-align:right;font-family:DejaVu Serif;font-size:15px;"/>
                                            </b>
                                        </td>
                                        <td style="border:1px solid black;text-align:right;align:right">
                                            <b>
                                                <t t-out="'{0:,.0f}'.format(int(total_earning)).replace(',', ' ')"
                                                   style="text-align:right;font-family:DejaVu Serif;font-size:15px;"/>
                                            </b>
                                        </td>
                                    </tr>
                                </table>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>