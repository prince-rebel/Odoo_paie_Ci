<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_template_header">
            <t t-if="not o" t-set="o" t-value="doc"/>
            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
            <div class="header">
                <div class="row">
                    <div class="col-3 mb4" style="margin-bottom:20px;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px;"
                             alt="Logo"/>
                    </div>
                </div>
                <div class="info_header" style="margin-left: 2px;">
                    <div class="row" style="margin-left: 2px;">
                        <table style="width: 100%; border-style: none;">
                            <tr>
                                <td style="width: 50%; border-style: none; font-size: 16px; text-align:left;font-family:DejaVu Serif;">
                                    <div style="text-align:left;margin-left:2px;font-family:DejaVu Serif;">
                                        <strong style="color: #FF9633;">« Partout, proche de vous »</strong>
                                        <br/>
                                        --------------------
                                        <br/>
                                        DIRECTION GENERALE
                                        <br/>
                                        -------------------------
                                        <br/>
                                        DIRECTION DES RESSOURCES
                                        <br/>
                                        HUMAINES
                                        <br/>
                                        -------------------------
                                        <br/>
                                    </div>
                                </td>
                                <td style="width: 10%;border-style: none;"/>
                                <td style="width: 40%; text-align: center; border-style: none; font-size: 14px;font-family:DejaVu Serif;">
                                    <strong>REPUBLIQUE DE CÔTE D’IVOIRE</strong>
                                    <br/>
                                    <strong>Union-Discipline-Travail</strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </template>

        <template id="report_template_pagination_footer">
            <div class="footer">
                <div class="text-center">
                    <t t-if="not o" t-set="o" t-value="docs"/>
                    <t t-if="not company">
                        <!-- Multicompany -->
                        <t t-if="company_id">
                            <t t-set="company" t-value="company_id"/>
                        </t>
                        <t t-elif="o and 'company_id' in o">
                            <t t-set="company" t-value="o.company_id.sudo()"/>
                        </t>
                        <t t-else="else">
                            <t t-set="company" t-value="res_company"/>
                        </t>
                    </t>
                    <center>
                        <div class="pagination" style="margin-left: auto;margin-right: auto;width: 6em">
                            <span class="page"/>/
                            <span class="topage"/>
                        </div>
                        <div style="font-size: 9px; border-top: 1px dashed #FF9633; margin-bottom: 10px;font-family:DejaVu Serif;">
                            <strong>
                                VEONE TECHNOLOGIE
                                <br/>
                                Siège social : Abidjan Bonoumin ,302 Ilot 23, I 80, Abidjan

                                <br/>
                                www.veone.net
                                <br/>
                            </strong>
                        </div>
                    </center>
                </div>
            </div>
        </template>

        <template id="hr_payroll_custom.payroll_report_layout">
            <t t-call="hr_payroll_custom.report_template_header"/>
            <div class="article">
                <t t-raw="0"/>
            </div>
            <t t-call="hr_payroll_custom.report_template_pagination_footer"/>
        </template>

    </data>
</odoo>