<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="planning_report_holidays_wizard_form_view" model="ir.ui.view">
            <field name="name">hr_holidays_custom.planning_report_holidays_wizard.form</field>
            <field name="model">hr_holidays_custom.planning_report_holidays</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="holiday_type_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="direction_ids" widget="many2many_tags" options="{'no_create':True}"/>
                    </group>
                    <group>
                        <field name="department_ids" widget="many2many_tags" options="{'no_create':True}"/>
                    </group>
                    <group>
                        <field name="service_ids" widget="many2many_tags" options="{'no_create':True}"/>
                    </group>
                    <group col="2">
                        <group>
                            <field name="gender" style="width:45%"/>
                        </group>
                    </group>

                    <footer>
                        <button name="print_report_pdf" string="Imprimer en pdf" type="object" class="btn-primary"/>
                        <button name="print_report_xls" string="Imprimer en xls" type="object" class="btn-primary"/>
                        <button string="Annuler" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="planning_report_holidays_act_window" model="ir.actions.act_window">
            <field name="name">Planning des congés annuel</field>
            <field name="res_model">hr_holidays_custom.planning_report_holidays</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>