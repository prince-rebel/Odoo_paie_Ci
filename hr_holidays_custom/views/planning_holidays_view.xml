<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="planning_holidays_form" model="ir.ui.view">
            <field name="name">hr_holidays_custom.planning_holidays.form</field>
            <field name="model">hr_holidays_custom.planning_holidays</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_validate" string="Valider" type="object"
                                class="oe_highlight" groups="hr_holidays.group_hr_holidays_manager"
                                modifiers="{'invisible': [('state', '!=', 'rh')]}"/>

                        <button name="action_submit" string="Soumettre aux RH" type="object"
                                class="oe_highlight" groups="hr_holidays.group_hr_holidays_manager"
                                modifiers="{'invisible': [('state', '!=', 'draft')]}"/>

                        <button name="action_rejected" string="Rejeter" type="object"
                                class="oe_highlight" groups="hr_holidays.group_hr_holidays_manager"
                                modifiers="{'invisible': [('state', 'not in', ['respo', 'rh'])]}"/>

                        <button name="action_cancel" string="Annuler" type="object"
                                class="oe_highlight" groups="hr_holidays.group_hr_holidays_manager"
                                modifiers="{'invisible': [('state', 'not in', ['draft', 'respo', 'rh'])]}"/>

                        <field name="state" widget="statusbar"/>
                    </header>

                    <sheet>
                        <group col="4">
                            <field name="name" modifiers="{'readonly': [('state', '=', 'done')]}"/>
                            <field name="employee_id" modifiers="{'readonly': [('state', '=', 'done')]}"/>
                            <field name="date_from" modifiers="{'readonly': [('state', '=', 'done')]}"/>
                            <field name="holiday_type" readonly="1"/>
                            <field name="date_end" modifiers="{'readonly': [('state', '=', 'done')]}"/>
                            <field name="number_of_days" modifiers="{'readonly': [('state', '=', 'done')]}"/>
                            <field name="service_id" modifiers="{'readonly': [('state', '=', 'done')]}"/>
                            <field name="department_id" modifiers="{'readonly': [('state', '=', 'done')]}"/>
                            <field name="direction_id" modifiers="{'readonly': [('state', '=', 'done')]}"/>
                            <field name="company_id" modifiers="{'readonly': [('state', '=', 'done')]}"/>
                        </group>
                    </sheet>

                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="planning_holidays_tree">
            <field name="name">hr_holidays_custom.planning_holidays.tree</field>
            <field name="model">hr_holidays_custom.planning_holidays</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="date_from"/>
                    <field name="date_end"/>
                    <field name="number_of_days"/>
                    <field name="service_id"/>
                    <field name="department_id"/>
                    <field name="direction_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="planning_holidays_act_window" model="ir.actions.act_window">
            <field name="name">Planning de congés</field>
            <field name="res_model">hr_holidays_custom.planning_holidays</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau planning de congés
                </p>
            </field>
        </record>

        <record id="my_planning_holidays_act_window" model="ir.actions.act_window">
            <field name="name">Mon Planning de congés</field>
            <field name="res_model">hr_holidays_custom.planning_holidays</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('employee_id.user_id', '=', uid)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un nouveau planning de congés
                </p>
            </field>
        </record>

    </data>
</odoo>