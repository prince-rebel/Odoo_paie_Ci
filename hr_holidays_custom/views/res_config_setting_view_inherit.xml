<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
            <field name="name">hr_holidays_custom.res.config.settings.form</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="70"/>
            <field name="inherit_id" ref="hr_custom.res_config_settings_view_form_inherit"/>
            <field name="arch" type="xml">
                <div name="second_alert_contract" position="after">
                    <div class="row mt16 o_settings_container" name="leaves_allowance_days">
                        <div class="col-12 col-lg-6 o_setting_box" id="local_leaves_allowances">
                            <div class="o_setting_right_pane">
                                <label for="number_holidays_locaux"/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        Nombre de jours de congés mensuels à attribuer aux employés locaux
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="number_holidays_locaux"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="expatriate_leaves_allowances">
                            <div class="o_setting_right_pane">
                                <label for="number_holidays_expat"/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        Nombre de jours de congés mensuels à attribuer aux employés expatriés
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="number_holidays_expat"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="stock_legal_absence">
                            <div class="o_setting_right_pane">
                                <label for="stock_legal_absence"/>
                                <div class="row">
                                    <div class="text-muted col-lg-8">
                                        Stock maximum annuel des absences légales autorisées
                                    </div>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="stock_legal_absence"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>